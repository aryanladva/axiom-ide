{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Astra Dark",
  "id": "astra-dark",
  "dark": {
    "palette": {
      "neutral": "#0a0a0f",
      "ink": "#e8e8f0",
      "primary": "#6d5ef8",
      "accent": "#8b7bff",
      "success": "#3ecf8e",
      "warning": "#f5a623",
      "error": "#ef5b5b",
      "info": "#5ba3f5",
      "diffAdd": "#2fbf71",
      "diffDelete": "#ef5b5b"
